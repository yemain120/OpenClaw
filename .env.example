# ==============================================================================
# OPENCLAW ENVIRONMENT CONFIGURATION (.env)
# Copy this file to .env and configure your keys before running or deploying.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI MODEL PROVIDERS (At least one is required)
# ------------------------------------------------------------------------------
# Gemini API Key (Recommended for high speed and generous free quota)
# Available at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
VITE_GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# OpenAI API Key (GPT-4o, GPT-4o-mini, o3-mini)
# Available at: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# Anthropic API Key (Claude 3.7 Sonnet, Claude 3.5 Haiku)
# Available at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-api03-your-anthropic-key"

# Groq API Key (Ultra-fast Llama-3.3-70b inference)
# Available at: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key"

# Local Ollama URL (Default: http://localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"

# ------------------------------------------------------------------------------
# 2. OPENCLAW GATEWAY RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# Default WebSocket / Control plane port
OPENCLAW_GATEWAY_PORT="18789"
OPENCLAW_GATEWAY_HOST="0.0.0.0"

# Secret Gateway Bearer Token for securing remote nodes and WebSocket clients
OPENCLAW_GATEWAY_TOKEN="claw_sec_994a37b60e82c5f10ad948b2"

# Master Web UI Dashboard access password (optional security)
OPENCLAW_ADMIN_PASSWORD="admin_change_this_password"

# Allowed CORS Origins (comma separated)
OPENCLAW_CORS_ALLOWED="*"

# ------------------------------------------------------------------------------
# 3. MESSAGING CHANNELS (Optional - configure if connecting chat apps)
# ------------------------------------------------------------------------------
# Telegram Bot
# Create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_ALLOWED_USERS="123456789,987654321"

# Discord Bot
# Create via https://discord.com/developers/applications
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_CLIENT_ID="your_discord_application_client_id"

# Slack Bot
# Create via https://api.slack.com/apps
SLACK_BOT_TOKEN="xoxb-your-slack-bot-token"
SLACK_APP_TOKEN="xapp-your-slack-app-level-token"
SLACK_SIGNING_SECRET="your_slack_signing_secret"

# WhatsApp Session Name (Uses Baileys Web multi-device session)
WHATSAPP_SESSION_NAME="openclaw-production-session"

# Webhook Secret for custom HTTP triggers
WEBHOOK_SECRET="webhook_secret_key_random_string"

# ------------------------------------------------------------------------------
# 4. EXECUTION SANDBOX & SEARCH TOOLS
# ------------------------------------------------------------------------------
# E2B Sandbox API Key (for isolated cloud code & terminal execution)
# Available at: https://e2b.dev
E2B_API_KEY=""

# Browserless API Key (for cloud headless browser scraping / Playwright)
# Available at: https://browserless.io
BROWSERLESS_API_KEY=""

# Serper Google Search API Key (for live web search results)
# Available at: https://serper.dev
SERPER_API_KEY=""

# ------------------------------------------------------------------------------
# 5. VERCEL DEPLOYMENT URL
# ------------------------------------------------------------------------------
# Your deployed production domain on Vercel
VITE_APP_URL="https://openclaw-web.vercel.app"
